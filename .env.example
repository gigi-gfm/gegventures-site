# Copy this file to .env and fill in your values.
# Get an Anthropic key at https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to 3000
# PORT=3000

# First-time admin account. If no users exist when the server boots,
# it creates this admin automatically. After the first user is created
# you can remove these and add more users via the Users page.
ADMIN_EMAIL=gigi@example.com
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_NAME=Gigi Garcia

# VoiceRx integration (optional). When set, the IME Studio shows a
# "Pull from VoiceRx" button next to the Physical Exam field that
# fetches recent dictations from VoiceRx.
# VOICERX_TOKEN is the per-provider access token from the voicerx-api
# providers table (the same token Dr. Garcia pastes into VoiceRx's
# Settings panel).
# VOICERX_API_URL defaults to the workers.dev URL and only needs to be
# set if you've put VoiceRx on a custom domain.
# VOICERX_TOKEN=
# VOICERX_API_URL=https://voicerx-api.winter-shadow-e82d.workers.dev
